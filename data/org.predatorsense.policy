<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Predator Sense for Linux</vendor>
  <action id="org.predatorsense.control">
    <description>Change fan, performance mode, lighting and battery settings</description>
    <description xml:lang="pt_BR">Alterar ventoinhas, modo de desempenho, iluminação e bateria</description>
    <message>Authentication is required to change the laptop's hardware settings</message>
    <message xml:lang="pt_BR">É necessária autenticação para alterar as configurações de hardware do notebook</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>
</policyconfig>

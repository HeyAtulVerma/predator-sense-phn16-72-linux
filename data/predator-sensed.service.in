[Unit]
Description=Predator Sense for Linux service
Documentation=file:///usr/share/doc/predator-sense/README.md
After=systemd-modules-load.service dbus.service
ConditionPathExistsGlob=/sys/bus/wmi/devices/7A4DDFE7-5B5D-40B4-8595-4408E0CC7F56*

[Service]
Type=dbus
BusName=org.predatorsense.Daemon
ExecStartPre=-modprobe predator_wmi
ExecStart=@CMAKE_INSTALL_FULL_LIBEXECDIR@/predator-sensed
Restart=on-failure
RestartSec=2
StateDirectory=predator-sense
# Hardening: the service only needs the WMI node, sysfs and NVML.
ProtectHome=yes
ProtectSystem=strict
PrivateTmp=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
LockPersonality=yes

[Install]
WantedBy=multi-user.target

# The service is (re)started by 90-predator-sense.hook, which runs after DKMS has built the module.
post_install() {
    systemctl daemon-reload
    systemctl enable predator-sensed.service || true
}
post_upgrade() {
    systemctl daemon-reload
}
pre_remove() {
    systemctl disable --now predator-sensed.service || true
    modprobe -r predator_wmi 2>/dev/null || true
}
